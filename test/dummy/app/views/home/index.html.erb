<h1>SafeBro dummy app</h1>
<p>Pretend to be a user, then open <%= link_to "/bro_hub", "/bro_hub" %> (or SafeBro mounted on its own at <%= link_to "/console", safe_bro.root_path %>).</p>
<p>Signed in as: <strong><%= current_user&.email || "nobody" %></strong></p>

<%= form_with url: role_path, method: :post do %>
  <% (User::ROLES + [ nil ]).each do |role| %>
    <button type="submit" name="role" value="<%= role %>"><%= role || "sign out" %></button>
  <% end %>
  <input type="hidden" name="return_to" value="/bro_hub">
<% end %>

<ul>
  <li><strong>staff</strong>: no access to the console audit UI</li>
  <li><strong>auditor</strong>: can review sessions</li>
</ul>
